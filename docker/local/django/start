#!/bin/bash
set -e

echo "🚀 Starting migrations..."
python3 manage.py migrate
python3 manage.py collectstatic --no-input

echo "🧠 Starting Django server..."
python3 manage.py runserver "0.0.0.0:${DJANGO_LISTENING_PORT:-9081}" &

echo "🎧 Waiting 5s before launching Kafka consumer..."
sleep 10
python3 manage.py run_kafka_consumer --topic=all