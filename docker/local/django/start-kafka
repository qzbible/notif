#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

echo "=== Starting Kafka Consumer Service ==="

# ============================================
# 1. Attendre que PostgreSQL soit prêt
# ============================================
echo "⏳ Checking PostgreSQL availability..."

python << END
import sys, time, psycopg2

timeout = 30
start = time.time()

while True:
    try:
        psycopg2.connect(
            dbname="${POSTGRES_DB}",
            user="${POSTGRES_USER}",
            password="${POSTGRES_PASSWORD}",
            host="${POSTGRES_HOST}",
            port="${POSTGRES_PORT}",
        )
        print("✅ PostgreSQL is available")
        break
    except psycopg2.OperationalError as e:
        if time.time() - start > timeout:
            sys.stderr.write("❌ PostgreSQL did not become available in time: {}\n".format(e))
            sys.exit(1)
        sys.stderr.write("⏳ Waiting for PostgreSQL...\n")
        time.sleep(1)
END

# ============================================
# 2. Vérifier la disponibilité de Kafka
# ============================================
echo "⏳ Checking Kafka availability..."

python << END
import socket, time, sys

host = "${KAFKA_BOOTSTRAP_SERVERS}".split(":")[0]
port = int("${KAFKA_BOOTSTRAP_SERVERS}".split(":")[1])
timeout = 30
start = time.time()

while True:
    try:
        s = socket.create_connection((host, port), timeout=3)
        s.close()
        print("✅ Kafka is available")
        break
    except Exception as e:
        if time.time() - start > timeout:
            sys.stderr.write("❌ Kafka broker not reachable: {}\n".format(e))
            sys.exit(1)
        sys.stderr.write("⏳ Waiting for Kafka broker...\n")
        time.sleep(2)
END

# ============================================
# 3. Démarrer le Kafka Consumer
# ============================================
echo "🚀 Starting Kafka Consumer..."
exec python3 manage.py run_kafka_consumer --topic=all
